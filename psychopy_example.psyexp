      <CodeComponent name="code" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="from pylsl import StreamInfo, StreamOutlet&amp;#10;&amp;#10;# Stream-Info definieren&amp;#10;info = StreamInfo(&amp;#10;    name='ScienceMode-Control',&amp;#10;    type='Markers',&amp;#10;    channel_count=1,&amp;#10;    nominal_srate=0,          # irregular rate, da Marker unregelmäßig kommen&amp;#10;    channel_format='string',&amp;#10;    source_id='psychopy_marker_stream_001'&amp;#10;)&amp;#10;&amp;#10;outlet = StreamOutlet(info)&amp;#10;&amp;#10;mouse = event.Mouse()&amp;#10;mouse.clickReset()&amp;#10;mouse_was_down = False  # Status: war die Taste im letzten Frame gedrückt?&amp;#10;&amp;#10;" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="import {StreamInfo, StreamOutlet} from 'pylsl';&amp;#10;info = new StreamInfo({&quot;name&quot;: &quot;ScienceMode-Control&quot;, &quot;type&quot;: &quot;Markers&quot;, &quot;channel_count&quot;: 1, &quot;nominal_srate&quot;: 0, &quot;channel_format&quot;: &quot;string&quot;, &quot;source_id&quot;: &quot;psychopy_marker_stream_001&quot;});&amp;#10;outlet = new StreamOutlet(info);&amp;#10;mouse = new psychoJS.eventManager.Mouse();&amp;#10;mouse.clickReset();&amp;#10;mouse_was_down = false;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="p24_trials_repeat = 0;&amp;#10;i24_trials_repeat = 0;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="&amp;#10;p24_trials_repeat = 0&amp;#10;i24_trials_repeat = 0" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="buttons = mouse.getPressed()&amp;#10;mouse_down_now = any(buttons)&amp;#10;&amp;#10;# Erst wenn die Maustaste tatsächlich losgelassen wurde, akzeptieren wir neue Klicks&amp;#10;if mouse_down_now and not mouse_was_down:&amp;#10;    if mouse.isPressedIn(start_btn_p24):&amp;#10;        p24_trials_repeat = 1&amp;#10;        continueRoutine = False&amp;#10;    elif mouse.isPressedIn(start_btn_i24):&amp;#10;        i24_trials_repeat = 1&amp;#10;        continueRoutine = False&amp;#10;        &amp;#10;mouse_was_down = mouse_down_now" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="buttons = mouse.getPressed();&amp;#10;mouse_down_now = any(buttons);&amp;#10;if ((mouse_down_now &amp;&amp; (! mouse_was_down))) {&amp;#10;    if (mouse.isPressedIn(start_btn_p24)) {&amp;#10;        p24_trials_repeat = 1;&amp;#10;        continueRoutine = false;&amp;#10;    } else {&amp;#10;        if (mouse.isPressedIn(start_btn_i24)) {&amp;#10;            i24_trials_repeat = 1;&amp;#10;            continueRoutine = false;&amp;#10;        }&amp;#10;    }&amp;#10;}&amp;#10;mouse_was_down = mouse_down_now;&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="/* Syntax Error: Fix Python code */" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="# Beim Start des Experiments/Trials:&amp;#10;outlet.push_sample(['START'])" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="code" valType="code" updates="None" name="name"/>
      </CodeComponent>
    </Routine>
