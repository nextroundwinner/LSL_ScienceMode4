      <CodeComponent name="code_3" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="mouse = event.Mouse()&amp;#10;mouse.clickReset()&amp;#10;mouse_was_down = False  # Status: war die Taste im letzten Frame gedrückt?&amp;#10;&amp;#10;" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="mouse = new psychoJS.eventManager.Mouse();&amp;#10;mouse.clickReset();&amp;#10;mouse_was_down = false;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="import {StreamInlet, resolve_byprop} from 'pylsl';&amp;#10;import * as np from 'numpy';&amp;#10;import {deque} from 'collections';&amp;#10;console.log(&quot;Suche LSL-Stream...&quot;);&amp;#10;streams = resolve_byprop(&quot;name&quot;, &quot;ScienceMode-Measurement-Data&quot;);&amp;#10;inlet = new StreamInlet(streams[0]);&amp;#10;console.log(&quot;Stream gefunden:&quot;, streams[0].name());&amp;#10;buffer_size = 200;&amp;#10;data_buffer = deque(([0] * buffer_size), {&quot;maxlen&quot;: buffer_size});&amp;#10;live_line = new visual.ShapeStim(psychoJS.window, {&quot;vertices&quot;: [[0, 0]], &quot;closeShape&quot;: false, &quot;lineWidth&quot;: 2, &quot;lineColor&quot;: &quot;white&quot;, &quot;units&quot;: &quot;height&quot;});&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="from pylsl import StreamInlet, resolve_byprop&amp;#10;import numpy as np&amp;#10;from collections import deque&amp;#10;&amp;#10;&amp;#10;# Sucht nach verfügbaren Streams (blockiert, bis mind. einer gefunden wird)&amp;#10;print(&quot;Suche LSL-Stream...&quot;)&amp;#10;streams = resolve_byprop('name', 'ScienceMode-Measurement-Data')  # oder 'name', 'DeinStreamName'&amp;#10;inlet = StreamInlet(streams[0])&amp;#10;print(&quot;Stream gefunden:&quot;, streams[0].name())&amp;#10;&amp;#10;&amp;#10;&amp;#10;buffer_size = 200&amp;#10;data_buffer = deque([0]*buffer_size, maxlen=buffer_size)&amp;#10;&amp;#10;live_line = visual.ShapeStim(&amp;#10;    win, &amp;#10;    vertices=[[0,0]], &amp;#10;    closeShape=False, &amp;#10;    lineWidth=2, &amp;#10;    lineColor='white',      # oder z.B. 'red', 'yellow', [1,1,1] etc.&amp;#10;    units='height'&amp;#10;)" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="&amp;#10;buttons = mouse.getPressed()&amp;#10;mouse_down_now = any(buttons)&amp;#10;&amp;#10;# Erst wenn die Maustaste tatsächlich losgelassen wurde, akzeptieren wir neue Klicks&amp;#10;if mouse_down_now and not mouse_was_down:&amp;#10;    if mouse.isPressedIn(p24_btn_pattern_1):&amp;#10;        data_buffer.clear()&amp;#10;        outlet.push_sample(['STIM_1'])&amp;#10;        # continueRoutine = False&amp;#10;    elif mouse.isPressedIn(p24_btn_pattern_2):&amp;#10;        data_buffer.clear()&amp;#10;        outlet.push_sample(['STIM_2'])&amp;#10;        # continueRoutine = False&amp;#10;    elif mouse.isPressedIn(p24_btn_exit):&amp;#10;        # outlet.push_sample(['STIM_2'])&amp;#10;        continueRoutine = False&amp;#10;        &amp;#10;mouse_was_down = mouse_down_now&amp;#10;&amp;#10;&amp;#10;&amp;#10;chunk, timestamps = inlet.pull_chunk()&amp;#10;buffer_size = len(chunk)&amp;#10;if chunk:&amp;#10;    data_buffer.extend([s[0] for s in chunk])&amp;#10;&amp;#10;    xs = np.linspace(-0.4, 0.4, buffer_size)&amp;#10;    &amp;#10;    raw = np.array(data_buffer)&amp;#10;    y_min, y_max = raw.min(), raw.max()&amp;#10;    &amp;#10;    if y_max &gt; y_min:  # Division durch 0 vermeiden, falls Signal konstant ist&amp;#10;        # Normalisieren auf 0..1, dann auf gewünschten Anzeigebereich (-0.4..0.4) skalieren&amp;#10;        ys = (raw - y_min) / (y_max - y_min) * 0.5 - 0.25&amp;#10;    else:&amp;#10;        ys = np.zeros_like(raw)  # konstantes Signal → flache Linie bei 0&amp;#10;    &amp;#10;    live_line.vertices = list(zip(xs, ys))&amp;#10;&amp;#10;live_line.draw()" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="&amp;#10;        // add-on: list(s: string): string[]&amp;#10;        function list(s) {&amp;#10;            // if s is a string, we return a list of its characters&amp;#10;            if (typeof s === 'string')&amp;#10;                return s.split('');&amp;#10;            else&amp;#10;                // otherwise we return s:&amp;#10;                return s;&amp;#10;        }&amp;#10;&amp;#10;        buttons = mouse.getPressed();&amp;#10;mouse_down_now = any(buttons);&amp;#10;if ((mouse_down_now &amp;&amp; (! mouse_was_down))) {&amp;#10;    if (mouse.isPressedIn(p24_btn_pattern_1)) {&amp;#10;        data_buffer.clear();&amp;#10;        outlet.push_sample([&quot;STIM_1&quot;]);&amp;#10;    } else {&amp;#10;        if (mouse.isPressedIn(p24_btn_pattern_2)) {&amp;#10;            data_buffer.clear();&amp;#10;            outlet.push_sample([&quot;STIM_2&quot;]);&amp;#10;        } else {&amp;#10;            if (mouse.isPressedIn(p24_btn_exit)) {&amp;#10;                continueRoutine = false;&amp;#10;            }&amp;#10;        }&amp;#10;    }&amp;#10;}&amp;#10;mouse_was_down = mouse_down_now;&amp;#10;[chunk, timestamps] = inlet.pull_chunk();&amp;#10;buffer_size = chunk.length;&amp;#10;if (chunk) {&amp;#10;    data_buffer.concat(function () {&amp;#10;    var _pj_a = [], _pj_b = chunk;&amp;#10;    for (var _pj_c = 0, _pj_d = _pj_b.length; (_pj_c &lt; _pj_d); _pj_c += 1) {&amp;#10;        var s = _pj_b[_pj_c];&amp;#10;        _pj_a.push(s[0]);&amp;#10;    }&amp;#10;    return _pj_a;&amp;#10;}&amp;#10;.call(this));&amp;#10;    xs = np.linspace((- 0.4), 0.4, buffer_size);&amp;#10;    raw = np.array(data_buffer);&amp;#10;    [y_min, y_max] = [raw.min(), raw.max()];&amp;#10;    if ((y_max &gt; y_min)) {&amp;#10;        ys = ((((raw - y_min) / (y_max - y_min)) * 0.5) - 0.25);&amp;#10;    } else {&amp;#10;        ys = np.zeros_like(raw);&amp;#10;    }&amp;#10;    live_line.vertices = list(zip(xs, ys));&amp;#10;}&amp;#10;live_line.draw();&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="code_3" valType="code" updates="None" name="name"/>
      </CodeComponent>
    </Routine>
